NODE_ENV=production
DATABASE_URL=postgresql://agentnovas_notification_worker:replace-me@127.0.0.1:5432/agentnovas
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_EMAIL_SEND_ENABLED=false
NOTIFICATION_WORKER_POOL_SIZE=4
NOTIFICATION_EMAIL_ALLOWLIST=
NOTIFICATION_TOKEN_ENCRYPTION_KEY=replace-with-the-same-client-and-notification-token-key
EMAIL_TEST_RECIPIENT_ENCRYPTION_KEY=replace-with-dedicated-test-recipient-key-at-least-32-characters
EMAIL_SECRET_DIRECTORY=/run/email-secrets
RESEND_API_KEY=
GIT_COMMIT_SHA=
