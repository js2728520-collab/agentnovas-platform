NODE_ENV=production
RESEARCH_DATABASE_URL=postgresql://agentnovas_runtime_worker:replace-me@127.0.0.1:5432/agentnovas
STRATEGY_RUNTIME_ENABLED=false
STRATEGY_RUNTIME_WORKER_POOL_SIZE=6
AI_GATEWAY_ENABLED=false
AI_GATEWAY_URL=http://127.0.0.1:3030
AI_GATEWAY_SHARED_SECRET=replace-with-dedicated-48-char-random
PLATFORM_DEMO_EXTERNAL_WRITES_ENABLED=false
GIT_COMMIT_SHA=

# 执行服务（ADR-0019）。实盘下发经由它完成，Worker 全程不接触任何客户凭证。
# 缺失时不会报错也不会阻断——下发失败只会被记成 liveExecutionError，
# 周期照常完成、七阶段叙述照常产出，看起来一切正常。所以必须配。
EXECUTION_SERVICE_URL=http://127.0.0.1:3020
EXECUTION_SERVICE_SHARED_SECRET=replace-with-48-char-random

# 真实下单的两个边界：市价单可接受的滑点带宽、意图有效期。
# 超出滑点带宽就不该成交——行情已经不是决策时的行情了。
RUNTIME_SLIPPAGE_TOLERANCE_PCT=0.5
RUNTIME_INTENT_VALID_FOR_MS=60000
