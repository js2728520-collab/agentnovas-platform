NODE_ENV=production
DATABASE_URL=postgresql://agentnovas_maint_web:replace-me@127.0.0.1:5432/agentnovas
PAYMENT_WEBHOOK_DATABASE_URL=postgresql://agentnovas_payment_webhook:replace-me@127.0.0.1:5432/agentnovas
TRUST_PROXY_HOPS=
MFA_TOTP_ENCRYPTION_KEY=replace-with-maintenance-mfa-key-at-least-32-characters
# Must use the same rollout state on Client, Operations and Maintenance.
MFA_ENFORCEMENT_ENABLED=false
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-maintenance-integration-key
LLM_PROFILE_ENCRYPTION_KEY=replace-with-maintenance-llm-key
RESEND_WEBHOOK_SECRET=
PAYMENT_WORKER_ENABLED=false
PAYMENT_PROVIDER_TESTS_ENABLED=false
UDUN_GATEWAY_BASE_URL=
UDUN_MERCHANT_ID=
UDUN_API_KEY=
UDUN_CALLBACK_URL=https://xm.agentnovas.com/api/integrations/payments/udun/webhook
NOTIFICATION_EMAIL_SEND_ENABLED=false
DEMO_EXECUTION_WORKER_ENABLED=false
CONFIGURATION_ACTIVATION_WORKER_ENABLED=false
PLATFORM_DEMO_EXTERNAL_WRITES_ENABLED=false
RIVERTON_RELEASE_TAG=
GIT_COMMIT_SHA=
RIVERTON_ARTIFACT_SHA256=

# 执行服务（ADR-0019）。账户验证与一键平仓都经过它——不配这两行，客户点这两个功能
# 会看到「服务不可用」。
# 本文件**不得**包含交易所凭证加密密钥：那把密钥只属于 execution.env。
EXECUTION_SERVICE_URL=http://127.0.0.1:3020
EXECUTION_SERVICE_SHARED_SECRET=replace-with-48-char-random
