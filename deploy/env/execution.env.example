# 执行服务：全系统唯一持有交易所凭证解密能力的进程（ADR-0019）。
#
# 三个 Web 应用都不再需要 EXCHANGE_CREDENTIAL_ENCRYPTION_KEY，它们通过内网调用
# 本服务完成账户验证、紧急平仓、实盘下单。
#
# 文件权限与其它 *.env 一致：0440 root:<node gid>，目录 0700 root:root。
NODE_ENV=production

# 必须使用执行服务自己的数据库角色。角色与 RIVERTON_EXECUTION_SERVICE 不匹配时
# 进程读凭证会失败——这是刻意的，用来防止它冒用 Web 角色。
DATABASE_URL=postgresql://agentnovas_execution_service:replace-me@127.0.0.1:5432/agentnovas
RIVERTON_EXECUTION_SERVICE=true

# 凭证加密密钥。**只有这个文件该有它**，迁移时务必沿用原值，否则库里已加密的
# 交易所凭证无法解密。
EXCHANGE_CREDENTIAL_ENCRYPTION_KEY=replace-with-existing-exchange-key

# 内网鉴权用的共享密钥，必须与三个 Web 和 Runtime Worker 的 env 完全一致。
# **必须与上面那把加密密钥是不同的值**：它只证明「请求来自我们自己的进程」，
# 不参与加密。设成同一个值等于把加密密钥发给了所有 Web 进程。
# 生成：openssl rand -base64 48 | tr -d '\n=/+' | head -c 48
EXECUTION_SERVICE_SHARED_SECRET=replace-with-48-char-random

EXECUTION_SERVICE_PORT=3020
# 裸机 systemd 部署保持 127.0.0.1。容器部署改成 0.0.0.0 并同时设置下面那行，
# 前提是该容器没有 ports 映射、不在 edge 网络上。
EXECUTION_SERVICE_HOST=127.0.0.1
EXECUTION_SERVICE_INTERNAL_NETWORK_ONLY=false

# 对账循环。关掉它会让每笔下单后的待对账记录永远不结案，
# 进而挡住该账户/该品种的新开仓。
EXECUTION_RECONCILIATION_ENABLED=true
EXECUTION_RECONCILIATION_INTERVAL_MS=15000
EXECUTION_RECONCILIATION_POOL_SIZE=2
EXECUTION_SERVICE_POOL_SIZE=4

GIT_COMMIT_SHA=
