NODE_ENV=production
DATABASE_URL=postgresql://agentnovas_client_web:replace-me@127.0.0.1:5432/agentnovas
CLIENT_AUTH_DATABASE_URL=postgresql://agentnovas_client_auth:replace-me@127.0.0.1:5432/agentnovas
TRUST_PROXY_HOPS=
# MFA_TOTP_ENCRYPTION_KEY must be identical across Client replicas and at least 32 characters.
# It must not reuse any provider/API credential or AI Gateway credential.
MFA_TOTP_ENCRYPTION_KEY=replace-with-client-mfa-key-at-least-32-characters
# Pre-production default: keep MFA enrollment data and APIs, but do not enforce login challenges.
# Set true only after the production MFA acceptance gate passes on all three applications.
MFA_ENFORCEMENT_ENABLED=false
NOTIFICATION_TOKEN_ENCRYPTION_KEY=replace-with-the-same-client-and-notification-token-key
STRATEGY_RESEARCH_ENABLED=false
STRATEGY_RUNTIME_ENABLED=false
AI_GATEWAY_ENABLED=false
AI_GATEWAY_URL=http://127.0.0.1:3030
AI_GATEWAY_SHARED_SECRET=replace-with-dedicated-48-char-random
PAYMENT_WORKER_ENABLED=false
PAYMENT_PROVIDER_OUTBOUND_ENABLED=false
PAYMENT_SECRET_DIRECTORY=/run/payment-secrets
UDUN_GATEWAY_BASE_URL=
UDUN_MERCHANT_ID=
UDUN_API_KEY=
UDUN_CALLBACK_URL=https://xm.agentnovas.com/api/integrations/payments/udun/webhook
UDUN_ADDRESS_REQUEST_COIN_FIELD=mainCoinType
NOTIFICATION_EMAIL_SEND_ENABLED=false
PLATFORM_DEMO_EXTERNAL_WRITES_ENABLED=false

# 执行服务（ADR-0019）。账户验证与一键平仓都经过它——不配这两行，客户点这两个功能
# 会看到「服务不可用」。
# 本文件**不得**包含交易所凭证加密密钥：那把密钥只属于 execution.env。
EXECUTION_SERVICE_URL=http://127.0.0.1:3020
EXECUTION_SERVICE_SHARED_SECRET=replace-with-48-char-random
