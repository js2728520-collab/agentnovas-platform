NODE_ENV=production
AI_GATEWAY_PROCESS=true
AI_GATEWAY_ENABLED=false
AI_GATEWAY_DATABASE_URL=postgresql://agentnovas_ai_gateway:replace-me@127.0.0.1:5432/agentnovas
AI_GATEWAY_SHARED_SECRET=replace-with-dedicated-48-char-random
AI_GATEWAY_PORT=3030
AI_GATEWAY_MAX_CONCURRENT=8
AI_GATEWAY_MAX_PER_MINUTE=120
AI_MANAGED_SECRET_DIRECTORY=/var/lib/agentnovas/ai-secrets
