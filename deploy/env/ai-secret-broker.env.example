NODE_ENV=production
AI_SECRET_BROKER_PROCESS=true
AI_SECRET_BROKER_ENABLED=false
AI_SECRET_BROKER_DATABASE_URL=postgresql://agentnovas_ai_secret_broker:replace-me@127.0.0.1:5432/agentnovas
AI_SECRET_BROKER_PRIVATE_KEY_FILE=/etc/agentnovas/secrets/ai-broker-private.pem
# For zero-downtime Broker key rotation, replace the single file above with a
# 0700 directory containing 0600 <sha256(brokerKeyId)>.pem generations.
# AI_SECRET_BROKER_PRIVATE_KEY_DIRECTORY=/etc/agentnovas/secrets/ai-broker-keyring
AI_MANAGED_SECRET_DIRECTORY=/var/lib/agentnovas/ai-secrets
