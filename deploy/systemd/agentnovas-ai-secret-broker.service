[Unit]
Description=AgentNovas AI Secret Broker
After=network.target postgresql.service

[Service]
Type=simple
User=agentnovas-ai
Group=agentnovas-ai
WorkingDirectory=/opt/agentnovas/current
EnvironmentFile=/etc/agentnovas/ai-secret-broker.env
LoadCredential=ai-broker-private.pem:/etc/agentnovas/secrets/ai-broker-private.pem
Environment=AI_SECRET_BROKER_PRIVATE_KEY_FILE=%d/ai-broker-private.pem
ExecStart=/usr/bin/npm run worker:ai-secret-broker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/agentnovas/ai-secrets

[Install]
WantedBy=multi-user.target
