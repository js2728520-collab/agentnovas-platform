[Unit]
Description=AgentNovas strategy runtime worker
After=network-online.target postgresql.service agentnovas-web.service
Wants=network-online.target

[Service]
Type=simple
User=agentnovas
Group=agentnovas
WorkingDirectory=/opt/agentnovas/current
EnvironmentFile=/etc/agentnovas/agentnovas.env
ExecStart=/usr/bin/npm run worker:runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentnovas

[Install]
WantedBy=multi-user.target
