[Unit]
Description=Riverton Capital operations web service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=agentnovas
Group=agentnovas
WorkingDirectory=/opt/agentnovas/current
EnvironmentFile=/etc/agentnovas/agentnovas.env
Environment=RIVERTON_APP_AUDIENCE=operations
Environment=PORT=3001
ExecStart=/usr/bin/npm run start:operations -- --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentnovas

[Install]
WantedBy=multi-user.target

