[Unit]
Description=AgentNovas restricted release orchestrator (%i)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=an-rel-worker-%i
Group=an-rel-worker-%i
WorkingDirectory=/opt/agentnovas/current
EnvironmentFile=/etc/agentnovas/release-orchestrator-%i.env
LoadCredential=release-orchestrator-%i-binding.json:/etc/agentnovas/release-orchestrator-%i-binding.json
LoadCredential=release-orchestrator-%i-app.pem:/etc/agentnovas/release-orchestrator-%i-app.pem
Environment=RELEASE_ORCHESTRATOR_BINDING_FILE=%d/release-orchestrator-%i-binding.json
Environment=RELEASE_ORCHESTRATOR_APP_PRIVATE_KEY_FILE=%d/release-orchestrator-%i-app.pem
ExecStart=/usr/bin/npm run worker:release-orchestrator
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
InaccessiblePaths=/etc/agentnovas

[Install]
WantedBy=multi-user.target
