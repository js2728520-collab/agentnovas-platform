NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://agentnovas:replace-me@127.0.0.1:5432/agentnovas
BOOTSTRAP_SECRET=replace-with-a-one-time-random-bootstrap-secret
STRATEGY_RESEARCH_ENABLED=false
STRATEGY_RESEARCH_WORKER_POOL_SIZE=6
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret
EXCHANGE_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
AUTOMATION_INTERNAL_SECRET=replace-with-a-long-random-automation-secret
CONSERVATIVE_PERPETUAL_MAKER_RATE=0.0005
CONSERVATIVE_PERPETUAL_TAKER_RATE=0.0007
